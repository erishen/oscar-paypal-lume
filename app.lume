// 管理端内容页导出（admin-only）：CSV（复用 csv_field）。
get "/api/admin/pages/export", (req) => {
  let g = admin_ok(req);
  if (g != null) { return g; }
  let rows = db.q0("SELECT * FROM flatpages ORDER BY url");
  let head = ["id","url","title","registration_required","updated_at"];
  let lines = [];
  let hline = [];
  for (h in head) { push(hline, csv_field(h)); }
  push(lines, join(hline, ","));
  if (rows != null) {
    for (r in rows) {
      let cell = [string(as_int(get(r, "id", 0), 0)),
                  s.str_or(get(r, "url", ""), ""),
                  s.str_or(get(r, "title", ""), ""),
                  string(as_int(get(r, "registration_required", 0), 0)),
                  s.str_or(s.iso_or_null(get(r, "updated_at", null)), "")];
      let c = [];
      for (v in cell) { push(c, csv_field(v)); }
      push(lines, join(c, ","));
    }
  }
  let csv = join(lines, "\n") + "\n";
  return { status: 200, type: "text/csv; charset=utf-8", body: csv,
           headers: { "Content-Disposition": "attachment; filename=\"pages.csv\"", "Cache-Control": "no-store" } };
};

patch "/api/admin/pages/:id", (req) => {
  let g = admin_ok(req);
  if (g != null) { return g; }
  let id = as_int(get(req.params, "id", 0), 0);
  if (db.row("SELECT id FROM flatpages WHERE id = ?", [string(id)]) == null) { return s.err(404, "页面未找到"); }
  let b = s.parse_body(req);
  if (b == null) { return s.err(422, "请求体不是合法 JSON"); }
  let title = trim(s.str_or(get(b, "title", ""), ""));
  if (len(title) == 0) { return s.err(422, "标题必填"); }
  db.exec("UPDATE flatpages SET title = ?, content = ?, updated_at = ? WHERE id = ?",
          [title, s.str_or(get(b, "content", ""), ""), string(now()), string(id)]);
  return s.ok({ id: id, title: title });
};

get "/api/admin/reports", (req) => {
  let g = admin_ok(req);
  if (g != null) { return g; }
  // 可选 ?since=（epoch 秒或 YYYY-MM-DD[THH:MM:SS]，UTC）：过滤汇总/畅销榜；
  // trend_7d 与 this_month 是「近7天/本月」固定窗口卡片，保持自身口径。
  let since = s.parse_epoch(get(req.query_params, "since", ""));
  let since_clause = "";
  let since_params = [];
  if (since != null) {
    since_clause = " AND created_at >= ?";
    push(since_params, string(since));
  }
  let paid_sql = "SELECT COUNT(*) AS n, COALESCE(SUM(total_cents),0) AS gross FROM orders WHERE status = 'paid'" + since_clause;
  let paid = db.row(paid_sql, since_params);
  let refunded_sql = "SELECT COUNT(*) AS n, COALESCE(SUM(refunded_cents),0) AS amount FROM orders";
  if (len(since_clause) > 0) { refunded_sql = refunded_sql + " WHERE 1=1" + since_clause; }
  let refunded = db.row(refunded_sql, since_params);
  // 不依赖 SQLite json_each：逐单解析 items_json 在 lume 侧聚合（订单量小，演示足够）
  let paid_rows = db.q("SELECT items_json FROM orders WHERE status = 'paid'" + since_clause, since_params);
  let counts = {};
  if (paid_rows != null) {
    for (o in paid_rows) {
      let parsed = try(() => json(s.str_or(get(o, "items_json", "[]"), "[]")));
      let its = get(parsed, "ok", []);
      for (it in its) {
        let name = s.str_or(get(it, "name", ""), "");
        if (len(name) > 0) { put(counts, name, as_int(get(counts, name, 0), 0) + as_int(get(it, "quantity", 0), 0)); }
      }
    }
  }
  let rows = [];
  for (name in keys(counts)) { push(rows, { name: name, qty: as_int(get(counts, name, 0), 0) }); }
  let n = len(rows);
  let oi = 0;
  while (oi < n) {
    let oj = 0;
    while (oj < n - 1 - oi) {
      let a = as_int(get(get(rows, oj, {}), "qty", 0), 0);
      let b = as_int(get(get(rows, oj + 1, {}), "qty", 0), 0);
      if (a < b) {
        let tmp = get(rows, oj, {});
        put(rows, oj, get(rows, oj + 1, {}));
        put(rows, oj + 1, tmp);
      }
      oj = oj + 1;
    }
    oi = oi + 1;
  }
  if (n > 10) {
    let limited = [];
    let ki = 0;
    while (ki < 10) { push(limited, get(rows, ki, {})); ki = ki + 1; }
    rows = limited;
  }
  // 销售趋势（与 get_store_stats 一致）：近7天逐日补零 + 本月
  let tq = db.q("SELECT date(created_at,'unixepoch') AS day, COUNT(*) AS n, COALESCE(SUM(total_cents),0) AS gross FROM orders WHERE status='paid' AND created_at >= ? GROUP BY day",
                [string(now() - 7 * 86400)]);
  let trend = {};
  if (tq != null) {
    for (row in tq) {
      put(trend, s.str_or(get(row, "day", ""), ""), { n: as_int(get(row, "n", 0), 0), gross: as_int(get(row, "gross", 0), 0) });
    }
  }
  let trend_7d = [];
  let base = now() - (now() % 86400);
  let di = 6;
  while (di >= 0) {
    let ts = base - di * 86400;
    let day = substr(str(s.iso_or_null(ts)), 0, 10);
    let g = get(trend, day, null);
    let tn = 0;
    let tg = 0;
    if (g != null) { tn = get(g, "n", 0); tg = get(g, "gross", 0); }
    push(trend_7d, { date: day, orders: tn, gross_cents: tg, gross: tg / 100.0 });
    di = di - 1;
  }
  let ms = db.q0("SELECT strftime('%s', date('now','start of month')) AS ms");
  let month_start = as_int(get(get(ms, 0, {}), "ms", 0), 0);
  let month = db.row("SELECT COUNT(*) AS n, COALESCE(SUM(total_cents),0) AS gross FROM orders WHERE status='paid' AND created_at >= ?",
                     [string(month_start)]);
  let mg = as_int(get(month, "gross", 0), 0);
  return s.ok({
    paid_orders: as_int(get(paid, "n", 0), 0),
    gross_cents: as_int(get(paid, "gross", 0), 0),
    refunded_cents: as_int(get(refunded, "amount", 0), 0),
    top_products: rows,
    trend_7d: trend_7d,
    this_month: { orders: as_int(get(month, "n", 0), 0), gross_cents: mg, gross: mg / 100.0 }
  });
};

// ============================================================
// Agent 工具（LLM 可调用的商店能力）
//   供 lume 原生 Agent（POST /react/api/chat）注册给 LLM 的函数。
//   只读公开数据（目录/订单状态/经营统计），不含用户隐私（邮件/地址）。
//   金额一律整数分（price_cents）；返回对象由框架自动序列化为 JSON 给模型。
// ============================================================

// 只读、无副作用；参数缺省按类型给零值，可选字段用 get() 兜底。
tool "search_products", "查询商店在售商品列表（可按关键词/分类过滤）",
  { keyword: string, category: string, limit: int },
  func(arg) {
    let kw = trim(s.str_or(get(arg, "keyword", ""), ""));
    let cat = trim(s.str_or(get(arg, "category", ""), ""));
    let limit = as_int(get(arg, "limit", 10), 10);
    if (limit < 1) { limit = 10; }
    if (limit > 50) { limit = 50; }
    let sql = "SELECT * FROM products WHERE displayable = 1";
    let params = [];
    if (len(kw) > 0) {
      let like = "%" + kw + "%";
      sql = sql + " AND (name LIKE ? OR description LIKE ? OR sku LIKE ?)";
      push(params, like); push(params, like); push(params, like);
    }
    if (len(cat) > 0) {
      sql = sql + " AND category = ?";
      push(params, cat);
    }
    sql = sql + " ORDER BY name LIMIT ?";
    push(params, string(limit));
    let rows = db.q(sql, params);
    return { count: len(rows), results: product_list(rows) };
  };

tool "get_product", "按 slug 查询单个商品详情（含同分类推荐）",
  { slug: string },
  func(arg) {
    let slug = s.str_or(get(arg, "slug", ""), "");
    if (len(slug) == 0) { return { error: "缺少 slug" }; }
    let r = db.row("SELECT * FROM products WHERE slug = ? AND displayable = 1", [slug]);
    if (r == null) { return { error: "商品未找到" }; }
    return product_obj(r);
  };

tool "get_categories", "列出商店商品分类及各类商品数",
  {},
  func(arg) {
    let rows = db.q0("SELECT category, COUNT(*) AS n FROM products WHERE displayable = 1 AND category IS NOT NULL GROUP BY category ORDER BY category");
    let out = [];
    if (rows != null) {
      for (r in rows) {
        push(out, { name: get(r, "category", ""), count: as_int(get(r, "n", 0), 0) });
      }
    }
    return { categories: out };
  };

tool "get_store_stats", "商店经营统计：商品数、分类数、已支付订单数、总销售额、近7天销售趋势、本月销售",
  {},
  func(arg) {
    let p = db.q0("SELECT COUNT(*) AS n FROM products WHERE displayable = 1");
    let c = db.q0("SELECT COUNT(DISTINCT category) AS n FROM products WHERE displayable = 1 AND category IS NOT NULL");
    let paid = db.row("SELECT COUNT(*) AS n, COALESCE(SUM(total_cents),0) AS gross FROM orders WHERE status = 'paid'", []);
    let gross = as_int(get(paid, "gross", 0), 0);
    // 近 7 天销售趋势：按天分组（UTC），无单日补零，保证返回完整 7 天
    let tq = db.q("SELECT date(created_at,'unixepoch') AS day, COUNT(*) AS n, COALESCE(SUM(total_cents),0) AS gross FROM orders WHERE status='paid' AND created_at >= ? GROUP BY day",
                  [string(now() - 7 * 86400)]);
    let trend = {};
    if (tq != null) {
      for (row in tq) {
        put(trend, s.str_or(get(row, "day", ""), ""), { n: as_int(get(row, "n", 0), 0), gross: as_int(get(row, "gross", 0), 0) });
      }
    }
    let trend_7d = [];
    let base = now() - (now() % 86400);
    let di = 6;
    while (di >= 0) {
      let ts = base - di * 86400;
      let day = substr(str(s.iso_or_null(ts)), 0, 10);
      let g = get(trend, day, null);
      let n = 0;
      let gr = 0;
      if (g != null) { n = get(g, "n", 0); gr = get(g, "gross", 0); }
      push(trend_7d, { date: day, orders: n, gross_cents: gr, gross: gr / 100.0 });
      di = di - 1;
    }
    // 本月（自然月，UTC 起）
    let ms = db.q0("SELECT strftime('%s', date('now','start of month')) AS ms");
    let month_start = as_int(get(get(ms, 0, {}), "ms", 0), 0);
    let month = db.row("SELECT COUNT(*) AS n, COALESCE(SUM(total_cents),0) AS gross FROM orders WHERE status='paid' AND created_at >= ?",
                       [string(month_start)]);
    let mg = as_int(get(month, "gross", 0), 0);
    return {
      product_count: as_int(get(get(p, 0, {}), "n", 0), 0),
      category_count: as_int(get(get(c, 0, {}), "n", 0), 0),
      paid_order_count: as_int(get(paid, "n", 0), 0),
      gross_cents: gross,
      gross: gross / 100.0,
      trend_7d: trend_7d,
      this_month: {
        orders: as_int(get(month, "n", 0), 0),
        gross_cents: mg,
        gross: mg / 100.0
      }
    };
  };

// 订单状态跟踪：只回公开字段（无邮件/地址/退款明细），供客服/物流问答。
tool "track_order", "按订单号查询订单状态与商品明细（不含用户隐私）",
  { order_no: string },
  func(arg) {
    let no = s.str_or(get(arg, "order_no", ""), "");
    if (len(no) == 0) { return { error: "缺少 order_no" }; }
    let o = db.row("SELECT * FROM orders WHERE order_no = ?", [no]);
    if (o == null) { return { error: "订单未找到" }; }
    let items = [];
    let ij = get(o, "items_json", "[]");
    if (ij != null and len(ij) > 0) {
      let parsed = try(() => json(ij));
      if (get(parsed, "err", null) == null and get(parsed, "ok", null) != null) {
        items = get(parsed, "ok", []);
      }
    }
    return {
      order_no: no,
      status: s.str_or(get(o, "status", ""), ""),
      total_cents: as_int(get(o, "total_cents", 0), 0),
      total: as_int(get(o, "total_cents", 0), 0) / 100.0,
      currency: s.str_or(get(o, "currency", "USD"), "USD"),
      item_count: as_int(get(o, "item_count", 0), 0),
      items: items,
      created_at: as_int(get(o, "created_at", 0), 0)
    };
  };

// ============================================================
// 未注册路径：不建 custom route 兜底，让它们落到宿主 docroot（./web/dist）静态层，
// 静态 404 + Accept: text/html 时走 SPA history fallback → index.html。
// 而 /api/* /auth/* /static/* 是已注册 custom route，优先级高于 docroot。
// ============================================================

// ---------- 启动前自检 + 交给宿主（agent-httpd）运行 ----------
let app_env = s.env_or("APP_ENV", "development");
if (app_env == "production" and not pp.configured()) {
  print("refusing to start: production 需要 PayPal 凭据（" + cfg.path() + "）");
} else {
  if (not auth.secret_is_configured()) {
    print("warning: secret_key 未配置，" + cfg.path() + " 缺失；仅限本地开发");
  }
  if (not pp.configured()) {
    print("warning: PayPal 凭据未配置，下单/结算将不可用；目录与静态功能不受影响");
  }
  run();
}
