// 商品上下架 / 库存 / 价格：PATCH {displayable?, stock?, price_cents?}
patch "/api/admin/products/:product_id", (req) => {
  let g = admin_ok(req);
  if (g != null) { return g; }
  let pid = as_int(get(req.params, "product_id", 0), 0);
  if (pid <= 0) { return s.err(422, "product_id 非法"); }
  let p = db.row("SELECT * FROM products WHERE id = ?", [string(pid)]);
  if (p == null) { return s.err(404, "商品未找到"); }

  let b = s.parse_body(req);
  if (b == null) { return s.err(422, "请求体不是合法 JSON"); }

  let cur_disp = as_int(get(p, "displayable", 1), 1);
  let cur_stock = as_int(get(p, "stock", 0), 0);
  let cur_price = as_int(get(p, "price_cents", 0), 0);
  let dv = get(b, "displayable", null);
  let sv = get(b, "stock", null);
  let pv = get(b, "price_cents", null);
  let disp = dv == null ? cur_disp : as_int(dv, cur_disp);
  let stock = sv == null ? cur_stock : as_int(sv, cur_stock);
  let price = pv == null ? cur_price : as_int(pv, cur_price);
  if (disp != 0 and disp != 1) { return s.err(422, "displayable 需为 0/1"); }
  if (stock < 0) { return s.err(422, "stock 不能为负"); }
  if (price < 0) { return s.err(422, "price_cents 不能为负"); }

  db.exec("UPDATE products SET displayable = ?, stock = ?, price_cents = ? WHERE id = ?",
          [string(disp), string(stock), string(price), string(pid)]);
  let r = db.row("SELECT * FROM products WHERE id = ?", [string(pid)]);
  return s.ok(product_obj(r));
};

// ============================================================
// 账户扩展（对齐 Oscar customer）：注册 / 演示口令找回 / 地址簿 / 订单追踪
// ============================================================

func req_uid(req) {
  let sess = auth.session(req);
  if (sess == null) { return 0; }
  let u = db.row("SELECT id FROM users WHERE username = ?", [get(sess, "user", "")]);
  if (u == null) { return 0; }
  return as_int(get(u, "id", 0), 0);
}

func valid_email(v) {
  let e = lower(trim(v));
  if (len(e) < 5 or len(e) > 120) { return false; }
  if (contains(e, " ") or contains(e, "\t")) { return false; }
  let at = 0;
  let i = 0;
  while (i < len(e)) {
    if (substr(e, i, 1) == "@") { at = at + 1; }
    i = i + 1;
  }
  if (at != 1 or starts_with(e, "@") or ends_with(e, "@")) { return false; }
  let tail = substr(e, len(e) - 4, 4);
  return contains(e, ".") and len(tail) >= 2;
}

func valid_new_username(v) {
  let n = lower(trim(v));
  if (len(n) < 3 or len(n) > 32) { return false; }
  let allowed = "abcdefghijklmnopqrstuvwxyz0123456789_-";
  let i = 0;
  while (i < len(n)) {
    if (not contains(allowed, substr(n, i, 1))) { return false; }
    i = i + 1;
  }
  return true;
}

// 注册成功自动登录，对齐 Oscar RegisterUserMixin.register_user
post "/auth/register", (req) => {
  let g = s.guard(req);
  if (g != null) { return g; }
  let b = s.parse_body(req);
  if (b == null) { return s.err(422, "请求体不是合法 JSON"); }
  let username = lower(trim(s.str_or(get(b, "username", ""), "")));
  let email = lower(trim(s.str_or(get(b, "email", ""), "")));
  let pass = s.str_or(get(b, "password", ""), "");
  let pass2 = s.str_or(get(b, "password2", pass), pass);
  if (not valid_new_username(username)) { return s.err(422, "用户名需 3-32 位，限小写字母/数字/_-"); }
  if (not valid_email(email)) { return s.err(422, "邮箱格式不正确"); }
  if (len(pass) < 9 or pass != pass2) { return s.err(422, "口令至少 9 位且两次输入一致"); }
  if (auth.user_by_name(username) != null) { return s.err(409, "用户名已存在"); }
  let by_email = db.row("SELECT id FROM users WHERE lower(email) = ?", [email]);
  if (by_email != null) { return s.err(409, "邮箱已注册"); }

  auth.create_user(username, pass, "customer");
  db.exec("UPDATE users SET email = ? WHERE username = ?", [email, username]);
  let token = auth.issue_token(username);
  return s.json_res(201, {
    username: username, email: email, role: "customer",
    access_token: token, token_type: "bearer"
  }, { "Set-Cookie": auth.cookie_header(token) });
};

// 演示环境没有邮件服务（Oscar sandbox 用 console backend），这里直接把 token
// 返回给调用方，便于 E2E/人工走完重置流程；production 下不返回 token。
post "/auth/password-reset/request", (req) => {
  let g = s.guard(req);
  if (g != null) { return g; }
  let b = s.parse_body(req);
  if (b == null) { return s.err(422, "请求体不是合法 JSON"); }
  let email = lower(trim(s.str_or(get(b, "email", ""), "")));
  // per-email 节流：防分布式攻击者轰炸特定邮箱（per-IP 5/15min 之外的第二道）；
  // 短窗口（默认 3/300s）绑定 DoS 上限——单人不会 5 分钟内 3 次请求重置。
  if (len(email) > 0) {
    let rt = s.rate_take("resetemail|" + email,
                         int(s.env_or("RATE_LIMIT_RESET_EMAIL_REQUESTS", "3")),
                         int(s.env_or("RATE_LIMIT_RESET_EMAIL_WINDOW", "300")));
    if (get(rt, "over", false)) {
      return s.err(429, "重置请求过于频繁，请稍后再试");
    }
  }
  let u = db.row("SELECT id, username FROM users WHERE lower(email) = ?", [email]);
  let out = { message: "如果该邮箱已注册，重置链接已生成" };
  if (u != null) {
    let uid = as_int(get(u, "id", 0), 0);
    db.exec("DELETE FROM password_resets WHERE user_id = ?", [string(uid)]);
    let uname = s.str_or(get(u, "username", ""), "");
    // 返回给用户的明文 token 只在响应/邮件出现一次；库里只存它的 HMAC 哈希，
    // 库泄露不会直接暴露可用重置 token（对齐最佳实践：token 落库必须哈希）。
    let token = substr(hmac_sha256(auth.secret(), "reset:" + uname + ":" + string(now())), 0, 32);
    let token_hash = hmac_sha256(auth.secret(), "resethash:" + token);
    db.exec("INSERT INTO password_resets (user_id, token, created_at) VALUES (?,?,?)",
            [string(uid), token_hash, string(now())]);
    if (s.env_or("APP_ENV", "development") != "production") {
      put(out, "demo_token", token);
      put(out, "demo_url", "/#/reset?token=" + token);
    }
  }
  return s.ok(out);
};

post "/auth/password-reset/confirm", (req) => {
  let g = s.guard(req);
  if (g != null) { return g; }
  let b = s.parse_body(req);
  if (b == null) { return s.err(422, "请求体不是合法 JSON"); }
  let token = s.str_or(get(b, "token", ""), "");
  let pass = s.str_or(get(b, "password", ""), "");
  if (len(pass) < 9) { return s.err(422, "口令至少 9 位"); }
  // 库里存的是 token 哈希（见 /auth/password-reset/request），这里同样哈希后查找。
  let token_hash = hmac_sha256(auth.secret(), "resethash:" + token);
  let rec = db.row("SELECT * FROM password_resets WHERE token = ?", [token_hash]);
  if (rec == null or get(rec, "used_at", null) != null) { return s.err(400, "重置链接无效或已使用"); }
  if (as_int(get(rec, "created_at", 0), 0) + 3600 < now()) { return s.err(400, "重置链接已过期"); }
  let u = db.row("SELECT username FROM users WHERE id = ?", [string(get(rec, "user_id", 0))]);
  if (u == null) { return s.err(400, "重置链接无效"); }
  let uname = s.str_or(get(u, "username", ""), "");
  db.exec("UPDATE users SET password_hash = ? WHERE id = ?", [auth.hash_password(pass, uname), string(get(rec, "user_id", 0))]);
  db.exec("UPDATE password_resets SET used_at = ? WHERE id = ?", [string(now()), string(get(rec, "id", 0))]);
  return s.ok({ message: "口令已重置，请重新登录" });
};

func address_obj(r) {
  if (r == null) { return null; }
  return {
    id: as_int(get(r, "id", 0), 0),
    first_name: s.str_or(get(r, "first_name", ""), ""),
    last_name: s.str_or(get(r, "last_name", ""), ""),
    line1: s.str_or(get(r, "line1", ""), ""),
    line2: get(r, "line2", null),
    line3: get(r, "line3", null),
    city: s.str_or(get(r, "city", ""), ""),
    state: get(r, "state", null),
    postcode: s.str_or(get(r, "postcode", ""), ""),
    country: s.str_or(get(r, "country", "CN"), "CN"),
    phone: get(r, "phone", null),
    notes: get(r, "notes", null),
    is_default_shipping: as_int(get(r, "is_default_shipping", 0), 0) != 0,
    is_default_billing: as_int(get(r, "is_default_billing", 0), 0) != 0
  };
}

func clear_addr_defaults(uid, aid, kind) {
  if (kind == "shipping") {
    db.exec("UPDATE user_addresses SET is_default_shipping = 0 WHERE user_id = ? AND id != ?", [string(uid), string(aid)]);
  } else {
    db.exec("UPDATE user_addresses SET is_default_billing = 0 WHERE user_id = ? AND id != ?", [string(uid), string(aid)]);
  }
}

get "/api/addresses/", (req) => {
  let g = s.guard(req);
  if (g != null) { return g; }
  let uid = req_uid(req);
  if (uid == 0) { return auth.require_login(req); }
  let rows = db.q("SELECT * FROM user_addresses WHERE user_id = ? ORDER BY is_default_shipping DESC, id DESC", [string(uid)]);
  let out = [];
  if (rows != null) { for (r in rows) { push(out, address_obj(r)); } }
  return s.ok({ addresses: out });
};

post "/api/addresses/", (req) => {
  let g = s.guard(req);
  if (g != null) { return g; }
  let uid = req_uid(req);
  if (uid == 0) { return auth.require_login(req); }
  let b = s.parse_body(req);
  if (b == null) { return s.err(422, "请求体不是合法 JSON"); }
  let first = trim(s.str_or(get(b, "first_name", ""), ""));
  let last = trim(s.str_or(get(b, "last_name", ""), ""));
  let line1 = trim(s.str_or(get(b, "line1", ""), ""));
  let city = trim(s.str_or(get(b, "city", ""), ""));
  let postcode = trim(s.str_or(get(b, "postcode", ""), ""));
  if (len(first) == 0 or len(last) == 0 or len(line1) == 0 or len(city) == 0 or len(postcode) == 0) {
    return s.err(422, "姓名/地址/城市/邮编必填");
  }
  let def_ship = as_int(get(b, "is_default_shipping", 0), 0) == 1;
  let def_bill = as_int(get(b, "is_default_billing", 0), 0) == 1;
  db.exec("INSERT INTO user_addresses (user_id, first_name, last_name, line1, line2, line3, city, state, postcode, country, phone, notes, is_default_shipping, is_default_billing, created_at) VALUES (?,?,?,?,?,?,?,?,?,?,?,?,?,?,?)",
          [string(uid), first, last, line1, s.str_or(get(b, "line2", ""), ""), s.str_or(get(b, "line3", ""), ""),
           city, s.str_or(get(b, "state", ""), ""), upper(postcode), s.str_or(get(b, "country", "CN"), "CN"),
           s.str_or(get(b, "phone", ""), ""), s.str_or(get(b, "notes", ""), ""),
           def_ship ? "1" : "0", def_bill ? "1" : "0", string(now())]);
  let row = db.row("SELECT * FROM user_addresses WHERE user_id = ? ORDER BY id DESC LIMIT 1", [string(uid)]);
  let aid = as_int(get(row, "id", 0), 0);
  if (def_ship) { clear_addr_defaults(uid, aid, "shipping"); }
  if (def_bill) { clear_addr_defaults(uid, aid, "billing"); }
  return s.created(address_obj(db.row("SELECT * FROM user_addresses WHERE id = ?", [string(aid)])));
};

patch "/api/addresses/:id", (req) => {
  let g = s.guard(req);
  if (g != null) { return g; }
  let uid = req_uid(req);
  if (uid == 0) { return auth.require_login(req); }
  let aid = as_int(get(req.params, "id", 0), 0);
  let old = db.row("SELECT * FROM user_addresses WHERE id = ? AND user_id = ?", [string(aid), string(uid)]);
  if (old == null) { return s.err(404, "地址未找到"); }
  let b = s.parse_body(req);
  if (b == null) { return s.err(422, "请求体不是合法 JSON"); }
  let fields = ["first_name", "last_name", "line1", "line2", "line3", "city", "state", "postcode", "country", "phone", "notes"];
  let vals = [];
  for (f in fields) {
    if (get(b, f, null) != null) { push(vals, s.str_or(get(b, f, ""), "")); }
    else { push(vals, s.str_or(get(old, f, ""), "")); }
  }
  let def_ship = as_int(get(b, "is_default_shipping", get(old, "is_default_shipping", 0)), 0) == 1;
  let def_bill = as_int(get(b, "is_default_billing", get(old, "is_default_billing", 0)), 0) == 1;
  push(vals, def_ship ? "1" : "0");
  push(vals, def_bill ? "1" : "0");
  push(vals, string(aid));
  db.exec("UPDATE user_addresses SET first_name=?,last_name=?,line1=?,line2=?,line3=?,city=?,state=?,postcode=?,country=?,phone=?,notes=?,is_default_shipping=?,is_default_billing=? WHERE id=?", vals);
  if (def_ship) { clear_addr_defaults(uid, aid, "shipping"); }
  if (def_bill) { clear_addr_defaults(uid, aid, "billing"); }
  return s.ok(address_obj(db.row("SELECT * FROM user_addresses WHERE id = ?", [string(aid)])));
};

delete "/api/addresses/:id", (req) => {
  let g = s.guard(req);
  if (g != null) { return g; }
  let uid = req_uid(req);
  if (uid == 0) { return auth.require_login(req); }
  let aid = as_int(get(req.params, "id", 0), 0);
  let n = db.exec("DELETE FROM user_addresses WHERE id = ? AND user_id = ?", [string(aid), string(uid)]);
  if (as_int(n, 0) == 0) { return s.err(404, "地址未找到"); }
  return s.ok({ deleted: true, id: aid });
};

// 对齐 Oscar address-change-status
post "/api/addresses/:id/default", (req) => {
  let g = s.guard(req);
  if (g != null) { return g; }
  let uid = req_uid(req);
  if (uid == 0) { return auth.require_login(req); }
  let aid = as_int(get(req.params, "id", 0), 0);
  let a = db.row("SELECT * FROM user_addresses WHERE id = ? AND user_id = ?", [string(aid), string(uid)]);
  if (a == null) { return s.err(404, "地址未找到"); }
  let b = s.parse_body(req);
  let kind = b == null ? "shipping" : s.str_or(get(b, "kind", "shipping"), "shipping");
  if (kind != "shipping" and kind != "billing") { return s.err(422, "kind 需为 shipping/billing"); }
  if (kind == "shipping") {
    db.exec("UPDATE user_addresses SET is_default_shipping = 0 WHERE user_id = ?", [string(uid)]);
    db.exec("UPDATE user_addresses SET is_default_shipping = 1 WHERE id = ?", [string(aid)]);
  } else {
    db.exec("UPDATE user_addresses SET is_default_billing = 0 WHERE user_id = ?", [string(uid)]);
    db.exec("UPDATE user_addresses SET is_default_billing = 1 WHERE id = ?", [string(aid)]);
  }
  return s.ok(address_obj(db.row("SELECT * FROM user_addresses WHERE id = ?", [string(aid)])));
};

// 匿名订单追踪：Oscar 是 order_no + hash + email；演示用 order_no + 下单邮箱。
post "/api/orders/track", (req) => {
  let g = s.guard(req);
  if (g != null) { return g; }
  let b = s.parse_body(req);
  if (b == null) { return s.err(422, "请求体不是合法 JSON"); }
  let order_no = upper(trim(s.str_or(get(b, "order_no", ""), "")));
  let email = lower(trim(s.str_or(get(b, "email", ""), "")));
  if (len(order_no) == 0 or not valid_email(email)) { return s.err(422, "订单号与邮箱必填"); }
  let o = db.row("SELECT * FROM orders WHERE upper(order_no) = ?", [order_no]);
  if (o == null) { return s.err(404, "订单未找到"); }
  let guest = lower(trim(s.str_or(get(o, "guest_email", ""), "")));
  let owner = db.row("SELECT email FROM users WHERE id = ?", [string(get(o, "user_id", 0))]);
  let owner_email = owner == null ? "" : lower(trim(s.str_or(get(owner, "email", ""), "")));
  if (guest != email and owner_email != email) { return s.err(404, "订单未找到"); }
  let v = order_obj(o);
  return s.ok({
    order_no: get(v, "order_no", ""), status: get(v, "status", ""),
    total: get(v, "total", 0), currency: get(v, "currency", "USD"),
    created_at: get(v, "created_at", null), items: get(v, "items", [])
  });
};

// ============================================================
// 优惠券（对齐 Oscar voucher + basket:vouchers-add/remove）
// ============================================================

func basket_id_for(uid) {
  let b = db.row("SELECT id FROM baskets WHERE user_id = ?", [string(uid)]);
  if (b != null) { return as_int(get(b, "id", 0), 0); }
  db.exec("INSERT INTO baskets (user_id, updated_at) VALUES (?, ?)", [string(uid), string(now())]);
  let created = db.row("SELECT id FROM baskets WHERE user_id = ?", [string(uid)]);
  return as_int(get(created, "id", 0), 0);
}

// s.ok() 的载荷在 body 字符串里，取字段前要先解回来
func view_body(view) {
  let j = try(() => json(s.str_or(get(view, "body", "{}"), "{}")));
  return get(j, "ok", {});
}

post "/api/basket/voucher", (req) => {
  let g = s.guard(req);
  if (g != null) { return g; }
  let uid = basket_user_id(req);
  if (uid == null) { return auth.require_login(req); }
  let b = s.parse_body(req);
  if (b == null) { return s.err(422, "请求体不是合法 JSON"); }
  let code = upper(trim(s.str_or(get(b, "code", ""), "")));
  if (len(code) == 0) { return s.err(422, "券码必填"); }
  let v = db.row("SELECT * FROM vouchers WHERE upper(code) = ?", [code]);
  if (v == null) { return s.err(404, "券码不存在"); }
  let start = get(v, "start_at", null);
  let end = get(v, "end_at", null);
  if (as_int(get(v, "active", 0), 0) != 1 or (start != null and as_int(start, 0) > now()) or
      (end != null and as_int(end, 0) < now())) {
    return s.err(400, "券码不可用");
  }
  let limit = as_int(get(v, "usage_limit", 0), 0);
  if (limit > 0 and as_int(get(v, "num_orders", 0), 0) >= limit) { return s.err(400, "券码已用完"); }
  let b_id = basket_id_for(uid);
  let vid = as_int(get(v, "id", 0), 0);
  db.exec("DELETE FROM basket_vouchers WHERE basket_id = ?", [string(b_id)]); // 演示：一篮一券
  db.exec("INSERT INTO basket_vouchers (basket_id, voucher_id, created_at) VALUES (?,?,?)",
          [string(b_id), string(vid), string(now())]);
  let body = view_body(basket_view(req));
  if (as_int(get(body, "discount_cents", 0), 0) <= 0) {
    db.exec("DELETE FROM basket_vouchers WHERE basket_id = ?", [string(b_id)]);
    return s.err(400, "购物篮未满足该券的折扣条件");
  }
  return s.ok({
    message: "券已应用",
    code: code,
    discount_cents: get(body, "discount_cents", 0),
    subtotal_cents: get(body, "subtotal_cents", 0),
    total_cents: get(body, "total_cents", 0)
  });
};

// （移除券的路由已提前注册，见 basket_add 后；此处只保留参数路由）

// ============================================================
// 愿望单（对齐 Oscar wishlists：默认列表 + 行，未登录禁用）
// ============================================================

func user_wishlist(uid) {
  let w = db.row("SELECT * FROM wishlists WHERE user_id = ? ORDER BY id LIMIT 1", [string(uid)]);
  if (w != null) { return w; }
  let key = substr(hmac_sha256(auth.secret(), "wish:" + string(uid) + ":" + string(now())), 0, 6);
  db.exec("INSERT INTO wishlists (user_id, name, visibility, share_key, created_at) VALUES (?,?,?,?,?)",
          [string(uid), "Default", "PRIVATE", key, string(now())]);
  return db.row("SELECT * FROM wishlists WHERE user_id = ? ORDER BY id LIMIT 1", [string(uid)]);
}

func wishlist_obj(w) {
  if (w == null) { return { items: [], share_key: "" }; }
  let rows = db.q("SELECT wl.product_id, wl.quantity, p.sku, p.slug, p.name, p.price_cents, p.stock, p.image " +
                  "FROM wishlist_lines wl JOIN products p ON p.id = wl.product_id WHERE wl.wishlist_id = ? ORDER BY p.name",
                  [string(get(w, "id", 0))]);
  let items = [];
  if (rows != null) {
    for (r in rows) {
      push(items, {
        product_id: as_int(get(r, "product_id", 0), 0),
        sku: s.str_or(get(r, "sku", ""), ""),
        slug: s.str_or(get(r, "slug", ""), ""),
        name: s.str_or(get(r, "name", ""), ""),
        price: as_int(get(r, "price_cents", 0), 0) / 100.0,
        price_cents: as_int(get(r, "price_cents", 0), 0),
        stock: as_int(get(r, "stock", 0), 0),
        image: get(r, "image", null),
        quantity: as_int(get(r, "quantity", 0), 0)
      });
    }
  }
  return { name: s.str_or(get(w, "name", "Default"), "Default"), share_key: s.str_or(get(w, "share_key", ""), ""), items: items };
}

get "/api/wishlist/", (req) => {
  let g = s.guard(req);
  if (g != null) { return g; }
  let uid = req_uid(req);
  if (uid == 0) { return auth.require_login(req); }
  return s.ok(wishlist_obj(user_wishlist(uid)));
};

post "/api/wishlist/", (req) => {
  let g = s.guard(req);
  if (g != null) { return g; }
  let uid = req_uid(req);
  if (uid == 0) { return auth.require_login(req); }
  let b = s.parse_body(req);
  if (b == null) { return s.err(422, "请求体不是合法 JSON"); }
  let pid = as_int(get(b, "product_id", 0), 0);
  let qty = as_int(get(b, "quantity", 1), 1);
  if (pid <= 0 or qty <= 0) { return s.err(422, "product_id/quantity 非法"); }
  let p = db.row("SELECT id FROM products WHERE id = ? AND displayable = 1", [string(pid)]);
  if (p == null) { return s.err(404, "商品未找到"); }
  let w = user_wishlist(uid);
  let wid = as_int(get(w, "id", 0), 0);
  let line = db.row("SELECT id, quantity FROM wishlist_lines WHERE wishlist_id = ? AND product_id = ?", [string(wid), string(pid)]);
  if (line == null) {
    db.exec("INSERT INTO wishlist_lines (wishlist_id, product_id, quantity, created_at) VALUES (?,?,?,?)",
            [string(wid), string(pid), string(qty), string(now())]);
  } else {
    db.exec("UPDATE wishlist_lines SET quantity = ? WHERE id = ?",
            [string(as_int(get(line, "quantity", 0), 0) + qty), string(get(line, "id", 0))]);
  }
  return s.created(wishlist_obj(w));
};

delete "/api/wishlist/:product_id", (req) => {
  let g = s.guard(req);
  if (g != null) { return g; }
  let uid = req_uid(req);
  if (uid == 0) { return auth.require_login(req); }
  let pid = as_int(get(req.params, "product_id", 0), 0);
  let w = user_wishlist(uid);
  db.exec("DELETE FROM wishlist_lines WHERE wishlist_id = ? AND product_id = ?", [string(get(w, "id", 0)), string(pid)]);
  return s.ok(wishlist_obj(w));
};

// lume 扩展：愿望单直接加购（Oscar 原生需回到商品页加购）
post "/api/wishlist/:product_id/move-to-basket", (req) => {
  let g = s.guard(req);
  if (g != null) { return g; }
  let uid = basket_user_id(req);
  if (uid == null) { return auth.require_login(req); }
  let pid = as_int(get(req.params, "product_id", 0), 0);
  let w = user_wishlist(uid);
  let line = db.row("SELECT quantity FROM wishlist_lines WHERE wishlist_id = ? AND product_id = ?", [string(get(w, "id", 0)), string(pid)]);
  if (line == null) { return s.err(404, "愿望单中没有该商品"); }
  let b_id = basket_id_for(uid);
  let qty = as_int(get(line, "quantity", 1), 1);
  let old = db.row("SELECT quantity FROM basket_items WHERE basket_id = ? AND product_id = ?", [string(b_id), string(pid)]);
  if (old == null) {
    db.exec("INSERT INTO basket_items (basket_id, product_id, quantity) VALUES (?,?,?)", [string(b_id), string(pid), string(qty)]);
  } else {
    db.exec("UPDATE basket_items SET quantity = ? WHERE basket_id = ? AND product_id = ?",
            [string(as_int(get(old, "quantity", 0), 0) + qty), string(b_id), string(pid)]);
  }
  return s.ok({ moved: true, product_id: pid, quantity: qty });
};

// ============================================================
// 商品评价（对齐 Oscar reviews：默认免审核，登录用户唯一，匿名可填 name/email）
// ============================================================

func review_obj(r) {
  if (r == null) { return null; }
  return {
    id: as_int(get(r, "id", 0), 0),
    score: as_int(get(r, "score", 0), 0),
    title: s.str_or(get(r, "title", ""), ""),
    body: get(r, "body", null),
    author: len(s.str_or(get(r, "name", ""), "")) > 0 ? s.str_or(get(r, "name", ""), "") : "",
    created_at: s.iso_or_null(get(r, "created_at", null)),
    status: as_int(get(r, "status", 1), 1)
  };
}

get "/api/products/:slug/reviews", (req) => {
  let g = s.guard(req);
  if (g != null) { return g; }
  let slug = s.str_or(get(req.params, "slug", ""), "");
  let p = db.row("SELECT id FROM products WHERE slug = ?", [slug]);
  if (p == null) { return s.err(404, "商品未找到"); }
  let rows = db.q("SELECT r.*, u.username FROM reviews r LEFT JOIN users u ON u.id = r.user_id " +
                  "WHERE r.product_id = ? AND r.status = 1 ORDER BY r.id DESC LIMIT 100", [string(get(p, "id", 0))]);
  let out = [];
  if (rows != null) { for (r in rows) { push(out, review_obj(r)); } }
  return s.ok({ reviews: out });
};

post "/api/products/:slug/reviews", (req) => {
  let g = s.guard(req);
  if (g != null) { return g; }
  let slug = s.str_or(get(req.params, "slug", ""), "");
  let p = db.row("SELECT id FROM products WHERE slug = ?", [slug]);
  if (p == null) { return s.err(404, "商品未找到"); }
  let b = s.parse_body(req);
  if (b == null) { return s.err(422, "请求体不是合法 JSON"); }
  let uid = req_uid(req);
  let title = trim(s.str_or(get(b, "title", ""), ""));
  let score = as_int(get(b, "score", 0), 0);
  if (len(title) == 0 or score < 1 or score > 5) { return s.err(422, "标题必填，评分 1-5"); }
  let name = trim(s.str_or(get(b, "name", ""), ""));
  let email = lower(trim(s.str_or(get(b, "email", ""), "")));
  if (uid == 0 and (len(name) == 0 or not valid_email(email))) { return s.err(422, "匿名评价需填姓名和邮箱"); }
  if (uid > 0) {
    let dup = db.row("SELECT id FROM reviews WHERE product_id = ? AND user_id = ?", [string(get(p, "id", 0)), string(uid)]);
    if (dup != null) { return s.err(409, "每个商品只能评价一次"); }
  } else {
    let dup2 = db.row("SELECT id FROM reviews WHERE product_id = ? AND lower(email) = ?", [string(get(p, "id", 0)), email]);
    if (dup2 != null) { return s.err(409, "该邮箱已评价过此商品"); }
  }
  let author = name;
  if (len(author) == 0 and uid > 0) {
    let u = db.row("SELECT username FROM users WHERE id = ?", [string(uid)]);
    author = u == null ? "" : s.str_or(get(u, "username", ""), "");
  }
  db.exec("INSERT INTO reviews (product_id, user_id, name, email, title, body, score, status, created_at) VALUES (?,?,?,?,?,?,?,1,?)",
          [string(get(p, "id", 0)), uid == 0 ? null : string(uid), author, email, title,
           s.str_or(get(b, "body", ""), ""), string(score), string(now())]);
  let row = db.row("SELECT r.*, u.username FROM reviews r LEFT JOIN users u ON u.id = r.user_id ORDER BY r.id DESC LIMIT 1", []);
  return s.created(review_obj(row));
};

// ============================================================
// 内容页（对齐 Oscar flatpage /about/）
// ============================================================

get "/api/pages/", (req) => {
  let g = s.guard(req);
  if (g != null) { return g; }
  let rows = db.q0("SELECT url, title, registration_required FROM flatpages ORDER BY url");
  let out = [];
  if (rows != null) { for (r in rows) { push(out, {
    url: s.str_or(get(r, "url", ""), ""), title: s.str_or(get(r, "title", ""), ""),
    registration_required: as_int(get(r, "registration_required", 0), 0) != 0
  }); } }
  // 内容页列表变更极少（仅 admin 增删），1h 缓存。
  return s.json_res(200, { pages: out }, { "Cache-Control": "public, max-age=3600" });
};

get "/api/pages/:slug", (req) => {
  let g = s.guard(req);
  if (g != null) { return g; }
  let slug = s.str_or(get(req.params, "slug", ""), "");
  let url = "/" + slug + "/";
  let p = db.row("SELECT * FROM flatpages WHERE url = ? OR url = ?", [url, "/" + slug]);
  if (p == null) { return s.err(404, "页面未找到"); }
  return s.ok({
    url: s.str_or(get(p, "url", ""), ""),
    title: s.str_or(get(p, "title", ""), ""),
    content: get(p, "content", ""),
    registration_required: as_int(get(p, "registration_required", 0), 0) != 0
  });
};

