// 后台扩展（Oscar dashboard 演示切片）：用户 / 券 / 评价 / 内容页 / 报表
// ============================================================

get "/api/admin/users", (req) => {
  let g = admin_ok(req);
  if (g != null) { return g; }
  let rows = db.q0("SELECT id, username, email, role, created_at FROM users ORDER BY id LIMIT 500");
  let out = [];
  if (rows != null) { for (r in rows) { push(out, {
    id: as_int(get(r, "id", 0), 0), username: s.str_or(get(r, "username", ""), ""),
    email: get(r, "email", null), role: s.str_or(get(r, "role", "customer"), "customer"),
    created_at: s.iso_or_null(get(r, "created_at", null))
  }); } }
  return s.ok({ users: out });
};

patch "/api/admin/users/:id", (req) => {
  let g = admin_ok(req);
  if (g != null) { return g; }
  let id = as_int(get(req.params, "id", 0), 0);
  let u = db.row("SELECT id FROM users WHERE id = ?", [string(id)]);
  if (u == null) { return s.err(404, "用户未找到"); }
  let b = s.parse_body(req);
  if (b == null) { return s.err(422, "请求体不是合法 JSON"); }
  let role = s.str_or(get(b, "role", ""), "");
  if (role != "customer" and role != "admin") { return s.err(422, "role 需为 customer/admin"); }
  db.exec("UPDATE users SET role = ? WHERE id = ?", [role, string(id)]);
  return s.ok({ id: id, role: role });
};

get "/api/admin/vouchers", (req) => {
  let g = admin_ok(req);
  if (g != null) { return g; }
  let rows = db.q0("SELECT * FROM vouchers ORDER BY id LIMIT 200");
  let out = [];
  if (rows != null) { for (r in rows) { push(out, {
    id: as_int(get(r, "id", 0), 0), code: s.str_or(get(r, "code", ""), ""),
    name: s.str_or(get(r, "name", ""), ""), discount_type: s.str_or(get(r, "discount_type", ""), ""),
    value: as_int(get(r, "value", 0), 0), min_subtotal_cents: as_int(get(r, "min_subtotal_cents", 0), 0),
    max_discount_cents: as_int(get(r, "max_discount_cents", 0), 0),
    usage_limit: as_int(get(r, "usage_limit", 0), 0), num_orders: as_int(get(r, "num_orders", 0), 0),
    active: as_int(get(r, "active", 0), 0) != 0
  }); } }
  return s.ok({ vouchers: out });
};

post "/api/admin/vouchers", (req) => {
  let g = admin_ok(req);
  if (g != null) { return g; }
  let b = s.parse_body(req);
  if (b == null) { return s.err(422, "请求体不是合法 JSON"); }
  let code = upper(trim(s.str_or(get(b, "code", ""), "")));
  let dtype = s.str_or(get(b, "discount_type", "percentage"), "percentage");
  let value = as_int(get(b, "value", 0), 0);
  if (len(code) == 0 or value <= 0) { return s.err(422, "券码与折扣值必填"); }
  if (dtype != "percentage" and dtype != "absolute") { return s.err(422, "discount_type 非法"); }
  if (dtype == "percentage" and value > 100) { return s.err(422, "百分比不能超过 100"); }
  if (db.row("SELECT id FROM vouchers WHERE upper(code) = ?", [code]) != null) { return s.err(409, "券码已存在"); }
  db.exec("INSERT INTO vouchers (code, name, discount_type, value, min_subtotal_cents, max_discount_cents, usage_limit, active, created_at) VALUES (?,?,?,?,?,?,?,1,?)",
          [code, s.str_or(get(b, "name", code), code), dtype, string(value),
           string(as_int(get(b, "min_subtotal_cents", 0), 0)), string(as_int(get(b, "max_discount_cents", 0), 0)),
           string(as_int(get(b, "usage_limit", 0), 0)), string(now())]);
  let v = db.row("SELECT * FROM vouchers WHERE upper(code) = ?", [code]);
  return s.created({ id: as_int(get(v, "id", 0), 0), code: code, value: value, active: true });
};

patch "/api/admin/vouchers/:id", (req) => {
  let g = admin_ok(req);
  if (g != null) { return g; }
  let id = as_int(get(req.params, "id", 0), 0);
  if (db.row("SELECT id FROM vouchers WHERE id = ?", [string(id)]) == null) { return s.err(404, "券未找到"); }
  let b = s.parse_body(req);
  if (b == null) { return s.err(422, "请求体不是合法 JSON"); }
  let active = as_int(get(b, "active", 1), 1) == 1;
  db.exec("UPDATE vouchers SET active = ? WHERE id = ?", [active ? "1" : "0", string(id)]);
  return s.ok({ id: id, active: active });
};

get "/api/admin/reviews", (req) => {
  let g = admin_ok(req);
